# SERVER ENVIRONMENT VARIABLES
# Copy this file to server/.env and fill in the values

#  Database 
# PostgreSQL connection string
DATABASE_URL="postgresql://user:pass@localhost:5432/residentiq"

#  Redis 
# Redis connection URL
REDIS_URL="redis://localhost:6379"

#  JWT Authentication 
# Secret key for signing access tokens (use a long random string in production)
JWT_SECRET="change_me_to_a_long_random_secret"
# Secret key for signing refresh tokens
JWT_REFRESH_SECRET="change_me_to_another_long_random_secret"

#  Email (SMTP) 
# Used by the email worker to send booking confirmation emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
SMTP_FROM="ResidentIQ <noreply@residentiq.com>"

#  Server 
PORT="3000"

#  Frontend 
# The URL of the Next.js frontend (used for CORS)
FRONTEND_URL="http://localhost:3001"
