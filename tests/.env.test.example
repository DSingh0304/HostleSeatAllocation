# API URL of the running ResidentIQ server (include /api/v1 prefix)
API_URL=http://localhost:3000/api/v1

# Superadmin credentials (set during first-time setup or existing)
ADMIN_EMAIL=superadmin@residentiq.test
ADMIN_PASSWORD=Admin@123456

# Default password assigned to all seeded students and teachers
DEFAULT_PASSWORD=TestPass@123

# Test Configuration
TEST_TIMEOUT=30000
TEST_STUDENT_COUNT=1000
TEST_TEACHER_COUNT=30

# Performance thresholds (milliseconds)
MAX_API_RESPONSE_TIME=5000
MAX_BOOKING_TIME=3000
MAX_REPORT_GENERATION_TIME=10000
